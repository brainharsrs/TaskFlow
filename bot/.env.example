# Copie este arquivo para bot/.env e preencha. O .env NUNCA vai para o git (está no .gitignore).

# Token do @BotFather (formato 123456789:AA...). É secreto: não cole em chats nem no código.
TELEGRAM_BOT_TOKEN=

# Caminho do JSON da conta de serviço do Firebase. Guarde FORA da pasta do projeto,
# por exemplo: C:/Users/SEU_USUARIO/segredos/taskflow-service-account.json
FIREBASE_SERVICE_ACCOUNT_FILE=

# Opcionais
TZ=America/Sao_Paulo
SUMMARY_HOUR=7
